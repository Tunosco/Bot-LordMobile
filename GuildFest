def down():
    pyautogui.moveTo(rd.randint(140,1200),rd.randint(500,1000))
    pyautogui.drag(0,-195,1)
    time.sleep(rd.uniform(1,1.2))

def up():
    for i in range(3):
        pyautogui.moveTo(rd.randint(140,1200),rd.randint(450,700))
        pyautogui.drag(0,400,0.5)
        time.sleep(rd.uniform(0.1,0.5))

def reset():
    pyautogui.moveTo(pyautogui.locateCenterOnScreen('Aucune.png', confidence=0.8))
    pyautogui.click()
    time.sleep(rd.uniform(0.1,0.5))

def GF():
