    pyautogui.click()
    time.sleep(rd.uniform(0.1,0.5))
    pyautogui.moveTo(pyautogui.locateCenterOnScreen('Oui.png', confidence=0.8))
    pyautogui.click()
    time.sleep(rd.uniform(0.1,0.5))

